# Скопируйте в .env в корне репозитория. На сервере .env лежит в /opt/itscout/app/.env и в git не попадает.

APP_ENV=dev                      # dev | test | prod
DEMO_MODE=true                   # демо-вход, /admin/reseed, сброс ограничений
DEMO_ADMIN_EMAIL=admin@itscout.ru
DEMO_ADMIN_PASSWORD=             # пусто — демо-админ не создаётся; задаётся только в .env на сервере
BACKUP_KEEP_DAYS=7               # бэкапы БД и загрузок (сервис backup)
BACKUP_INTERVAL_HOURS=24
WEB_CONCURRENCY=3                # процессы uvicorn в Docker; лимиты и учёт LLM общие
RECOMMENDATIONS_CACHE_SECONDS=60  # кэш оценок подборки; 0 — выключен
WEBHOOK_ALLOW_PRIVATE_HOSTS=false     # true — только локально: webhook на http://localhost для отладки
EXPERT_INVITE_CODE=              # код-приглашение экспертов разметки (/expert/join); пусто — регистрация закрыта
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

POSTGRES_DB=itscout
POSTGRES_USER=itscout
POSTGRES_PASSWORD=itscout        # в prod — случайная строка

TEST_MODE=full                   # full | short (сокращённый тест для демо)
# Сигналы честности попытки (§10.9): пометка работодателю «стоит перепроверить», на грейд не влияет;
# false — не считаются, не сохраняются и не показываются
INTEGRITY_SIGNALS_ENABLED=true

# JWT_SECRET=                    # в prod обязательно, от 32 символов: openssl rand -hex 32

EMAIL_BACKEND=console            # console | smtp (в проде — контейнер mail: SMTP_HOST=mail)
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_FROM=noreply@itscout.ru       # для smtp должен совпадать с ящиком SMTP_USER
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl                # none | ssl | starttls
SMTP_USER=
SMTP_PASSWORD=                   # пароль приложения почтового ящика
NOTIFICATIONS_ENABLED=true       # письма о приглашениях и откликах (docs/implementation.md §8.9)
# NOTIFICATIONS_SKIP_DOMAINS=["example","test","invalid","localhost","example.com","example.net","example.org","demo.itscout.ru"]
# NOTIFICATIONS_SKIP_EMAILS=["e2e-candidate@itscout.ru"]

LLM_PROVIDER=none                # none | yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

FSP_API_KEY=dev-fsp-key

# Мок IdP «ФСП ID» (Keycloak, realm fsp из infra/keycloak). Пароль админа — только здесь: openssl rand -hex 24
KEYCLOAK_ADMIN_PASSWORD=
# Привязка через ФСП ID (OIDC). Значения по умолчанию подходят для compose; для настоящего ФСП ID — свои
# FSP_OIDC_DISCOVERY_URL=http://keycloak:8080/fsp-id/realms/fsp/.well-known/openid-configuration
# FSP_OIDC_CLIENT_ID=itscout
# FSP_OIDC_CLIENT_SECRET=        # только для конфиденциального клиента
# FSP_OIDC_REDIRECT_URI=         # по умолчанию ${PUBLIC_BASE_URL}/api/v1/fsp/oidc/callback
