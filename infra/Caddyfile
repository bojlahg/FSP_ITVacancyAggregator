(site) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# Доступ по IP (и любой хост) по HTTP — работает без DNS.
:80 {
	import site
}

# Домен: Caddy сам выпускает сертификат Let's Encrypt и редиректит HTTP → HTTPS. www добавить после A-записи.
itscout.ru {
	import site
}
