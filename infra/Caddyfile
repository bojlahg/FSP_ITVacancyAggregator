(site) {
	encode zstd gzip

	# Заголовки безопасности для всего сайта; CSP — только для фронта (Swagger на /api/docs грузит CDN)
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	handle /api/* {
		# Резюме — до 5 МБ (проверка в backend); больше Caddy не принимает и не пишет на диск
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8000
	}

	# Мок IdP «ФСП ID» (Keycloak): наружу только realm fsp и статика страницы входа, админка и master закрыты
	handle /fsp-id/* {
		@closed not path /fsp-id/realms/fsp/* /fsp-id/resources/*
		respond @closed 404
		reverse_proxy keycloak:8080
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'self'; object-src 'none'"
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# По IP и любому другому хосту по HTTP — только health-check деплоя, остальное — на HTTPS-домен:
# иначе пароль при входе шёл бы открытым текстом, а Secure-cookie сессии по HTTP не сохраняется.
:80 {
	handle /api/v1/health {
		reverse_proxy backend:8000
	}
	handle /health {
		respond "ok" 200
	}
	handle {
		redir https://itscout.ru{uri} permanent
	}
}

# Домен: Caddy сам выпускает сертификат Let's Encrypt и редиректит HTTP → HTTPS.
itscout.ru {
	import site
	header Strict-Transport-Security "max-age=31536000"
}

www.itscout.ru {
	redir https://itscout.ru{uri} permanent
}
