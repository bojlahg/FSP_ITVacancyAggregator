(site) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# Доступ по IP (и любой хост) по HTTP — работает без DNS.
:80 {
	import site
}

# Блок с доменом включаем, когда A-запись itscout.ru укажет на сервер:
# Caddy сам выпустит сертификат Let's Encrypt и включит редирект на HTTPS.
# itscout.ru, www.itscout.ru {
# 	import site
# }
