(site) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Мок IdP «ФСП ID» (Keycloak): наружу только realm fsp и статика страницы входа, админка и master закрыты
	handle /fsp-id/* {
		@closed not path /fsp-id/realms/fsp/* /fsp-id/resources/*
		respond @closed 404
		reverse_proxy keycloak:8080
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}

# Доступ по IP (и любой хост) по HTTP — работает без DNS.
:80 {
	import site
}

# Домен: Caddy сам выпускает сертификат Let's Encrypt и редиректит HTTP → HTTPS.
itscout.ru {
	import site
}

www.itscout.ru {
	redir https://itscout.ru{uri} permanent
}
